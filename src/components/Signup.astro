---
import { site } from '../data/site';
---

<section class="section signup" id="signup" aria-labelledby="signup-title">
  <div class="container">
    <div class="signup__box">
      <p class="signup__status">
        <span class="signup__pulse" aria-hidden="true"></span>
        Sign-ups open soon
      </p>
      <h2 id="signup-title">
        Someone’s waiting<br />
        <span class="serif-italic accent">to meet you.</span>
      </h2>
      <p class="lead signup__lead">
        Our sign-up form is almost ready. Follow us and you’ll be the first to know when you can grab a spot for the
        opening night.
      </p>

      <ul class="signup__socials">
        <li>
          <a class="btn" href={site.socials.instagram.url} rel="noopener" target="_blank">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="3" width="18" height="18" rx="5"></rect><circle cx="12" cy="12" r="4"></circle><circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle></svg>
            Instagram <span class="signup__handle">{site.socials.instagram.handle}</span>
          </a>
        </li>
        <li>
          <a class="btn btn--ghost" href={site.socials.tiktok.url} rel="noopener" target="_blank">
            <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.6 5.82A4.28 4.28 0 0 1 15.54 3h-3.09v12.4a2.59 2.59 0 0 1-2.59 2.5c-1.42 0-2.6-1.16-2.6-2.6 0-1.72 1.66-3.01 3.37-2.48V9.66c-3.45-.46-6.47 2.22-6.47 5.64 0 3.33 2.76 5.7 5.69 5.7 3.14 0 5.69-2.55 5.69-5.7V9.01a7.35 7.35 0 0 0 4.3 1.38V7.3s-1.88.09-3.24-1.48z"></path></svg>
            TikTok <span class="signup__handle">{site.socials.tiktok.handle}</span>
          </a>
        </li>
      </ul>
    </div>
  </div>
</section>

<style>
  .signup {
    padding-top: 0;
  }

  .signup__box {
    position: relative;
    text-align: center;
    padding: clamp(2.5rem, 8vw, 5rem) clamp(1.25rem, 5vw, 4rem);
    border: 1.5px solid var(--ink);
    border-radius: calc(var(--radius) * 1.5);
    overflow: hidden;
    isolation: isolate;
  }

  /* A big faint heart in the background */
  .signup__box::before {
    content: '';
    position: absolute;
    inset: auto -10% -45% auto;
    width: min(70vw, 32rem);
    aspect-ratio: 1;
    background: var(--blush);
    z-index: -1;
    -webkit-mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.6-9.3C.8 8.1 3 4 6.9 4c2.2 0 3.7 1.2 5.1 3 1.4-1.8 2.9-3 5.1-3 3.9 0 6.1 4.1 4.5 7.7C19.5 16.4 12 21 12 21z"/></svg>') center / contain no-repeat;
    mask: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24"><path d="M12 21s-7.5-4.6-9.6-9.3C.8 8.1 3 4 6.9 4c2.2 0 3.7 1.2 5.1 3 1.4-1.8 2.9-3 5.1-3 3.9 0 6.1 4.1 4.5 7.7C19.5 16.4 12 21 12 21z"/></svg>') center / contain no-repeat;
    transform: rotate(-12deg);
  }

  .signup__status {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.4rem 1rem;
    margin-bottom: 1.5rem;
    border-radius: 999px;
    background: var(--blush);
    color: var(--red-deep);
    font-weight: 600;
    font-size: 0.9rem;
  }

  .signup__pulse {
    width: 0.6rem;
    height: 0.6rem;
    border-radius: 50%;
    background: var(--red);
    box-shadow: 0 0 0 0 rgb(215 38 30 / 0.5);
    animation: pulse 1.8s ease-out infinite;
  }

  @keyframes pulse {
    to {
      box-shadow: 0 0 0 0.6rem rgb(215 38 30 / 0);
    }
  }

  .signup__lead {
    margin: 1.5rem auto 2rem;
  }

  .signup__socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .signup__handle {
    font-weight: 400;
    opacity: 0.75;
  }

  @media (max-width: 26rem) {
    .signup__handle {
      display: none;
    }
  }
</style>
