---
import { site } from '../data/site';
import { nights } from '../data/events';
import { shortDate } from '../data/format';

const next = nights[0];
// The "proper" order of love, played backwards until we arrive at the start.
const steps = ['have children', 'get married', 'have s*x', 'fall in love'];
---

<section class="hero" id="top">
  <div class="container hero__grid">
    <div class="hero__copy">
      <p class="eyebrow">Blind date nights · {site.venue.city}</p>

      <h1 class="hero__title">
        <span class="hero__fixed">First we</span>
        <span class="hero__slot" aria-hidden="true" data-steps={JSON.stringify(steps)}>
          <span class="hero__word is-final">meet.</span>
        </span>
        <span class="sr-only">meet.</span>
      </h1>

      <p class="lead hero__lead">
        One-on-one blind dates at {site.venue.name}. No photos, no profiles, no swiping. Just a table, a drink and
        someone new. After that, a DJ and the rest of the night together.
      </p>

      <div class="hero__actions">
        <a class="btn" href="#how">How it works</a>
        <a class="btn btn--ghost" href="#dates">See the dates</a>
      </div>
    </div>

    {
      next && (
        <aside class="ticket" aria-label="Next blind date night">
          <p class="ticket__kicker">{next.label ?? 'Next night'}</p>
          <p class="ticket__date">{shortDate(next.date)}</p>
          <dl class="ticket__meta">
            <div>
              <dt>Where</dt>
              <dd>
                {site.venue.name}, {site.venue.city}
              </dd>
            </div>
            <div>
              <dt>Who</dt>
              <dd>Mostly 20–30, all welcome up to 40</dd>
            </div>
            <div>
              <dt>Price</dt>
              <dd>
                €{site.price.amount}, {site.price.includes}
              </dd>
            </div>
          </dl>
          <p class="ticket__note">You only pay once you’ve got a match.</p>
          <span class="ticket__stamp" aria-hidden="true">
            Who?
          </span>
        </aside>
      )
    }
  </div>
</section>

<script>
  const slot = document.querySelector<HTMLElement>('.hero__slot');
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (slot && !reduce) {
    const steps: string[] = JSON.parse(slot.dataset.steps ?? '[]');
    const word = slot.querySelector<HTMLElement>('.hero__word')!;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));

    const play = async () => {
      for (const step of steps) {
        word.className = 'hero__word is-in';
        word.textContent = step;
        await wait(900);
        word.classList.add('is-struck');
        await wait(650);
        word.classList.add('is-out');
        await wait(250);
      }
      word.className = 'hero__word is-in is-final';
      word.textContent = 'meet.';
    };

    play();
  }
</script>

<style>
  .hero {
    position: relative;
    padding-block: clamp(3rem, 9vw, 7rem) clamp(4rem, 10vw, 7rem);
    overflow: hidden;
  }

  .hero__grid {
    display: grid;
    gap: clamp(2.5rem, 6vw, 4rem);
    align-items: center;
  }

  @media (min-width: 60rem) {
    .hero__grid {
      grid-template-columns: 1.5fr 1fr;
    }
  }

  .hero__title {
    font-size: clamp(2.9rem, 13vw, 7.25rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    margin-bottom: 1.75rem;
  }

  .hero__fixed,
  .hero__slot {
    display: block;
  }

  .hero__slot {
    min-height: 1.08em;
    white-space: nowrap;
  }

  .hero__word {
    display: inline-block;
    position: relative;
    font-style: italic;
    font-weight: 500;
    color: var(--ink-soft);
  }

  .hero__word::after {
    content: '';
    position: absolute;
    left: -0.04em;
    right: -0.04em;
    top: 54%;
    height: 0.075em;
    background: var(--red);
    border-radius: 99px;
    transform: scaleX(0);
    transform-origin: left center;
    transition: transform 0.45s cubic-bezier(0.65, 0, 0.35, 1);
  }

  .hero__word.is-in {
    animation: word-in 0.35s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }

  .hero__word.is-struck::after {
    transform: scaleX(1);
  }

  .hero__word.is-out {
    opacity: 0;
    transform: translateY(-0.15em);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  .hero__word.is-final {
    color: var(--red);
  }

  .hero__word.is-final::after {
    display: none;
  }

  @keyframes word-in {
    from {
      opacity: 0;
      transform: translateY(0.25em);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  .hero__lead {
    margin-bottom: 2rem;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  /* Ticket card */
  .ticket {
    position: relative;
    background: var(--blush);
    border-radius: var(--radius);
    padding: clamp(1.5rem, 4vw, 2.25rem);
    max-width: 26rem;
    /* perforated left edge */
    -webkit-mask: radial-gradient(circle 0.55rem at 0 50%, #0000 98%, #000) left / 100% 100%;
    mask: radial-gradient(circle 0.55rem at 0 50%, #0000 98%, #000) left / 100% 100%;
    transform: rotate(1.5deg);
  }

  .ticket__kicker,
  .ticket__date {
    padding-right: 4.5rem;
  }

  .ticket__kicker {
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--red);
  }

  .ticket__date {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 2.6rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.1;
    margin: 0.35rem 0 1.25rem;
  }

  .ticket__meta {
    display: grid;
    gap: 0.6rem;
    margin: 0 0 1.25rem;
    padding-top: 1.25rem;
    border-top: 2px dashed rgb(215 38 30 / 0.3);
  }

  .ticket__meta div {
    display: grid;
    grid-template-columns: 4.5rem 1fr;
    gap: 0.75rem;
  }

  .ticket__meta dt {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }

  .ticket__meta dd {
    margin: 0;
    font-weight: 500;
  }

  .ticket__note {
    font-size: 0.95rem;
    font-weight: 600;
  }

  .ticket__stamp {
    position: absolute;
    top: 1.1rem;
    right: 1.1rem;
    display: grid;
    place-items: center;
    width: 4.5rem;
    height: 4.5rem;
    border: 2px solid var(--red);
    border-radius: 50%;
    color: var(--red);
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.1rem;
    transform: rotate(-14deg);
    opacity: 0.85;
  }
</style>
