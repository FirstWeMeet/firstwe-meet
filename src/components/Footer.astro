---
import Logo from './Logo.astro';
import { site } from '../data/site';

const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="container footer__inner">
    <div>
      <Logo size="lg" />
      <p class="footer__motto" translate="no">{site.motto.join(' ')}</p>
    </div>
    <div class="footer__side">
      <ul class="footer__links">
        <li><a href={site.socials.instagram.url} rel="noopener" target="_blank">Instagram</a></li>
        <li><a href={site.socials.tiktok.url} rel="noopener" target="_blank">TikTok</a></li>
      </ul>
      <p class="footer__small">
        Blind date nights at {site.venue.name}, {site.venue.city}.<br />
        © {year} {site.name}
      </p>
    </div>
  </div>
</footer>

<style>
  .footer {
    border-top: 1px solid var(--line);
    padding-block: 3rem;
  }

  .footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: 2rem;
  }

  .footer__motto {
    margin-top: 0.5rem;
    color: var(--ink-soft);
  }

  .footer__side {
    display: grid;
    gap: 0.75rem;
  }

  .footer__links {
    display: flex;
    gap: 1.25rem;
    margin: 0;
    padding: 0;
    list-style: none;
    font-weight: 600;
  }

  .footer__links a {
    text-decoration-color: var(--red);
    text-underline-offset: 4px;
  }

  .footer__small {
    color: var(--ink-soft);
    font-size: 0.9rem;
  }
</style>
