---
// Payment page linked from the match and reminder emails.
// Change the payment link or the waiting time here.
import '@fontsource-variable/inter';

const payUrl =
  'https://diensten.asnbank.nl/online/betaalverzoek/#/v2/4abe8690-8fc6-4faa-8147-72c7f7b7058f/ZSpy6GWDzR45gq2yqEWqeFUCb4aaybfz';
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <meta name="theme-color" content="#4a0e10" />
    <title>Bevestig je plek | First We Meet</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Pinyon+Script&display=swap" rel="stylesheet" />
  </head>
  <body>
    <main class="page">
      <img class="logo" src="/logo-licht.png" width="600" height="224" alt="First We Meet" />

      <p class="kicker">Je hebt een match</p>
      <h1>Bevestig je plek</h1>

      <dl class="details">
        <div><dt>Wanneer</dt><dd>Donderdag 10 december, 20:00</dd></div>
        <div><dt>Waar</dt><dd>Café De Gulle Gier, Rotterdam</dd></div>
        <div><dt>Prijs</dt><dd>€20, eerste drankje inbegrepen</dd></div>
      </dl>

      <a class="btn" href={payUrl} rel="noopener">Betaal €20</a>
      <p class="secure">Je betaalt veilig via een betaalverzoek van ASN Bank.</p>

      <ol class="steps">
        <li><span>1</span><p>Betaal €20 met de knop hierboven.</p></li>
        <li><span>2</span><p>Wij koppelen je betaling met de hand aan jouw match.</p></li>
        <li><span>3</span><p>Je krijgt een bevestiging per mail. Dan staat je plek vast.</p></li>
      </ol>

      <div class="note">
        <strong>Even geduld met je bevestiging</strong>
        <p>
          We controleren elke betaling zelf. Het kan daarom tot 2 dagen duren voordat je de bevestiging krijgt.
          Je plek blijft gewoon voor je bewaard zodra je hebt betaald.
        </p>
        <p>
          Betaal je vanaf de rekening van iemand anders, of heb je na 2 dagen nog niets gehoord?
          Antwoord dan even op onze match-mail.
        </p>
      </div>

      <p class="sign">Tot de 10e</p>
    </main>
  </body>
</html>

<style>
  :root {
    --bg: #4a0e10;
    --cream: #f6e7da;
    --soft: #e9d3c6;
    --mute: #d2b3a6;
    --line: rgb(233 211 198 / 0.28);
    --pink: #f08a94;
  }
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--cream);
    font-family: 'Inter Variable', system-ui, -apple-system, 'Segoe UI', sans-serif;
    font-size: 1.0625rem;
    line-height: 1.6;
    -webkit-font-smoothing: antialiased;
  }
  .page {
    max-width: 30rem;
    margin: 0 auto;
    padding: 3rem 1.5rem 4rem;
    text-align: center;
  }
  .logo {
    display: block;
    width: 10rem;
    height: auto;
    margin: 0 auto 2.75rem;
  }
  .kicker {
    margin: 0;
    font-family: Oswald, 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: var(--pink);
  }
  h1 {
    margin: 0.35rem 0 2rem;
    font-family: Oswald, 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: clamp(2.6rem, 11vw, 3.4rem);
    line-height: 1;
    letter-spacing: 0.01em;
    text-transform: uppercase;
  }
  .details {
    margin: 0 0 2rem;
    text-align: left;
    border-top: 1px solid var(--line);
  }
  .details div {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .details dt {
    font-family: Oswald, 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--mute);
    padding-top: 0.2rem;
  }
  .details dd {
    margin: 0;
    text-align: right;
  }
  .btn {
    display: block;
    padding: 1.1rem 1rem;
    border-radius: 10px;
    background: var(--cream);
    color: var(--bg);
    font-family: Oswald, 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 1.2rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-decoration: none;
    transition: transform 0.15s ease, background-color 0.15s ease;
  }
  .btn:hover {
    background: #fff;
    transform: translateY(-2px);
  }
  .btn:focus-visible {
    outline: 3px solid var(--pink);
    outline-offset: 3px;
  }
  .secure {
    margin: 0.75rem 0 2.5rem;
    font-size: 0.875rem;
    color: var(--mute);
  }
  .steps {
    list-style: none;
    margin: 0 0 2rem;
    padding: 0;
    text-align: left;
    display: grid;
    gap: 1rem;
  }
  .steps li {
    display: flex;
    gap: 0.9rem;
    align-items: flex-start;
  }
  .steps span {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border: 1px solid var(--soft);
    border-radius: 50%;
    font-family: Oswald, 'Arial Narrow', sans-serif;
    font-weight: 700;
    font-size: 0.85rem;
  }
  .steps p {
    margin: 0;
    padding-top: 0.05rem;
    color: var(--soft);
  }
  .note {
    text-align: left;
    padding: 1.25rem 1.25rem 0.25rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: rgb(0 0 0 / 0.12);
  }
  .note strong {
    display: block;
    margin-bottom: 0.4rem;
  }
  .note p {
    margin: 0 0 1rem;
    font-size: 0.95rem;
    color: var(--soft);
  }
  .sign {
    margin: 2.5rem 0 0;
    font-family: 'Pinyon Script', Georgia, serif;
    font-size: 2.2rem;
    color: #f1d9c4;
  }
</style>
